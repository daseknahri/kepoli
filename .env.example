SITE_URL=https://kepoli.com
SITE_EMAIL=contact@kepoli.com
WRITER_EMAIL=isalunemerovik@gmail.com
WP_LOCALE=en_US
WP_ADMIN_LOCALE=en_US
KEPOLI_AUTOSEED_ENABLE=1
KEPOLI_FORCE_RESEED=0
# Destructive one-time go-live reseed (wipes ALL content, then reseeds). Set to 1 for the
# cutover deploy ONLY, then back to 0. This env flag is the SAFE trigger (server-config, not
# web-reachable).
KEPOLI_FRESH_CUTOVER=0
# Opt-in admin recovery. WP_ADMIN_PASSWORD is applied only at FIRST install, so changing it here
# later never reaches the existing admin (so "login from env" fails). Set to 1 for ONE deploy to
# re-apply WP_ADMIN_PASSWORD to the WP_ADMIN_USER account + guarantee the administrator role, then
# set back to 0. Re-arms automatically whenever WP_ADMIN_PASSWORD changes. Safe to leave at 0.
KEPOLI_RESET_ADMIN=0
# Secret for the OPTIONAL manual URL cutover trigger (/?kepoli_do_cutover=<secret>&_wpnonce=...).
# Leave EMPTY to keep that URL trigger DISABLED (recommended). To enable it, set a long random
# value here AND in Coolify — it is required in addition to an admin login + a WordPress nonce.
KEPOLI_CUTOVER_SECRET=
CANONICAL_REDIRECT_HOSTS=www.kepoli.com,api.kepoli.com,recipe.kepoli.com
# Real WordPress cron. WP-Cron is disabled on page visits (DISABLE_WP_CRON is baked in) and driven
# instead by the wp-cron sidecar, which pings wp-cron.php on this interval (seconds). Keeps scheduled
# posts publishing on time on a low-traffic site + fires the automation jobs deterministically.
WP_CRON_INTERVAL=120

WORDPRESS_DB_NAME=kepoli
WORDPRESS_DB_USER=kepoli
WORDPRESS_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=contact@kepoli.com

# AdSense is two-stage. STAGE 1 (verify + get reviewed): with ADSENSE_ENABLE=0 the
# site still emits the <meta google-adsense-account> tag and serves /ads.txt from
# ADSENSE_PUB_ID, so you can connect the site in AdSense and have it reviewed WITHOUT
# showing a single ad. STAGE 2 (go live): set ADSENSE_ENABLE=1 only after Google
# Privacy & Messaging / a certified CMP is configured — that flips on the ad loader,
# which carries Consent Mode v2 defaults (denied for EEA/UK/CH until the CMP grants).
ADSENSE_CLIENT_ID=ca-pub-8166411196603757
ADSENSE_PUB_ID=pub-8166411196603757
ADSENSE_ENABLE=0
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_AFTER_INTRO=
ADSENSE_SLOT_MID_CONTENT=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_BELOW_CONTENT=
EZOIC_ADSTXT_ACCOUNT_ID=
EZOIC_ADSTXT_REDIRECT_URL=

# Optional Google services.
GA_ENABLE=0
GA_MEASUREMENT_ID=
SEARCH_CONSOLE_VERIFICATION=

# Optional lightweight traffic counter. Use a hidden Histats counter and base64-encode the full code.
HISTATS_ENABLE=0
HISTATS_CODE_BASE64=
HISTATS_EXCLUDE_ADMINS=1

# Optional AI repair for author-tools extraction. Keep disabled unless an API key is configured.
AI_EXTRACTION_ENABLE=0
AI_EXTRACTION_PROVIDER=openrouter
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_MODEL=inclusionai/ling-2.6-1t:free
AI_EXTRACTION_TIMEOUT_SECONDS=14
AI_EXTRACTION_MAX_CHARS=9000
AI_EXTRACTION_MAX_TOKENS=1400

# Optional deploy verification. Keep off for normal production pages.
KEPOLI_DEPLOY_FINGERPRINT=0
